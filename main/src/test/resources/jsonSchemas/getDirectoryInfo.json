{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Directory meta information Json-Schema",
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "pattern": "^disk:/.*"
    },
    "type": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "created": {
      "type": "string",
      "format": "date-time"
    },
    "modified": {
      "type": "string",
      "format": "date-time"
    },
    "resource_id": {
      "type": "string"
    },
    "revision": {
      "type": "integer"
    },
    "comment_ids": {
      "type": "object"
    },
    "exif": {
      "type": "object"
    },
    "_embedded": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^disk:/.*"
        },
        "limit": {
          "type": "integer"
        },
        "offset": {
          "type": "integer"
        },
        "sort": {
          "type": "string"
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "items": {
          "type": "array"
        }
      },
      "required": [
        "path",
        "limit",
        "offset",
        "sort",
        "total",
        "items"
      ]
    }
  },
  "required": [
    "path",
    "type",
    "name",
    "created",
    "modified",
    "resource_id",
    "revision",
    "comment_ids",
    "exif",
    "_embedded"
  ],
  "additionalProperties": false
}
